{
  "name": "valstine-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.2.18",
  "description": "A powerful cross-platform database management studio",
  "author": "Valstine",
  "main": "dist-electron/main.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently \"bun run server\" \"vite\"",
    "dev:front": "vite",
    "server": "bun run server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production bun run server/index.ts",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "native:rebuild:electron": "bunx electron-rebuild -f -w better-sqlite3 -w node-pty",
    "electron:dev": "bun run native:rebuild:electron && concurrently --kill-others-on-fail \"vite\" \"bun run electron:start-delayed\"",
    "electron:start-delayed": "tsc -p electron/tsconfig.json && node -e \"const h=require('http');(function c(){h.get('http://localhost:8080',r=>{if(r.statusCode<500)require('child_process').spawn(require('electron'),['.'],{stdio:'inherit'})}).on('error',()=>setTimeout(c,500))})()\"",
    "electron:build": "bun run native:rebuild:electron && vite build && tsc -p electron/tsconfig.json",
    "electron:dist": "bun run electron:build && electron-builder",
    "electron:dist:mac": "bun run electron:build && electron-builder --mac",
    "electron:dist:win": "bun run electron:build && electron-builder --win",
    "electron:dist:linux": "bun run electron:build && electron-builder --linux",
    "version:patch": "version=$(bun run scripts/bump-version.mjs patch) && git add package.json && git commit -m \"chore: bump version to $version\"",
    "version:minor": "version=$(bun run scripts/bump-version.mjs minor) && git add package.json && git commit -m \"chore: bump version to $version\"",
    "version:major": "version=$(bun run scripts/bump-version.mjs major) && git add package.json && git commit -m \"chore: bump version to $version\""
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.83.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "electron-updater": "^6.8.3",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "knex": "^3.2.9",
    "lucide-react": "^1.7.0",
    "monaco-editor": "^0.55.1",
    "mysql2": "^3.21.0",
    "next-themes": "^0.3.0",
    "node-pty": "^1.1.0",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-resizable-panels": "^4.9.0",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tedious": "^19.2.1",
    "vaul": "^0.9.9",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.11",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/tedious": "^18.0.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "lovable-tagger": "^1.1.13",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.valstine.studio",
    "productName": "Valstine Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/@mapbox/node-pre-gyp/**/*"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "public/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Valstine-Studio.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": ["nsis", "zip"],
      "icon": "public/icon.png",
      "artifactName": "Valstine-Studio-Setup.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "public/icon.png",
      "category": "Development",
      "artifactName": "Valstine-Studio.${ext}",
      "maintainer": "Valstine Studio <support@valstine.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "techfix-sqaud",
      "repo": "Valstine-studio"
    }
  }
}
