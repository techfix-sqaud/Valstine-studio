DO_AI_TOKEN=your_digitalocean_ai_agent_token_here
# AnalystOS is a separate app (see apps/analyst-os). In production it's usually
# reached at a same-origin /analyst-os path behind a reverse proxy, but locally
# it runs on its own Vite dev server, so point this at it directly.
VITE_ANALYST_OS_URL=http://localhost:8081
